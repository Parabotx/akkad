#!/usr/bin/env bash
set -Eeuo pipefail

STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
DISABLED_MARKER="$STATE_HOME/akkad/shell-disabled"
QS_BIN="$(command -v quickshell || true)"

say() { printf '\033[1;36m[AKKAD]\033[0m %s\n' "$*"; }
die() { printf '\033[1;31m[AKKAD]\033[0m %s\n' "$*" >&2; exit 1; }

[[ -n "$QS_BIN" ]] || die "quickshell is not installed. Install the AKKAD package set first."

stop_shell() {
  local binary
  binary="$(readlink -f "$QS_BIN")"
  pkill -f "^$binary --config akkad" 2>/dev/null || true
}

start_shell() {
  rm -f "$DISABLED_MARKER"
  stop_shell
  say "Starting the AKKAD shell..."
  "$QS_BIN" --config akkad --no-duplicate --daemonize
}

case "${1:-status}" in
  autostart)
    if [[ -e "$DISABLED_MARKER" ]]; then
      say "Shell autostart is disabled."
      exit 0
    fi
    "$QS_BIN" --config akkad --no-duplicate --daemonize
    ;;
  start|enable)
    mkdir -p "$(dirname "$DISABLED_MARKER")"
    start_shell
    ;;
  stop)
    stop_shell
    say "Stopped the AKKAD shell for this session."
    ;;
  restart)
    stop_shell
    sleep 0.5
    "$QS_BIN" --config akkad --no-duplicate --daemonize
    say "Restarted the AKKAD shell."
    ;;
  disable)
    mkdir -p "$(dirname "$DISABLED_MARKER")"
    : > "$DISABLED_MARKER"
    stop_shell
    say "Shell disabled. It will stay off after future logins."
    ;;
  status)
    binary="$(readlink -f "$QS_BIN")"
    if pgrep -af "^$binary --config akkad" >/dev/null; then
      say "AKKAD shell is running."
    else
      say "AKKAD shell is not running."
    fi
    if [[ -e "$DISABLED_MARKER" ]]; then
      say "Autostart: disabled."
    else
      say "Autostart: enabled."
    fi
    ;;
  *)
    printf 'Usage: akkad-shell {autostart|start|stop|restart|enable|disable|status}\n' >&2
    exit 2
    ;;
esac
